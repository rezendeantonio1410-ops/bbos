{
  "name": "bbos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "corepack pnpm --filter @bbos/database generate",
    "db:migrate": "corepack pnpm --filter @bbos/database migrate",
    "db:seed": "corepack pnpm --filter @bbos/database seed",
    "seed:lab-demo": "corepack pnpm --filter @bbos/database seed:lab-demo",
    "seed:lab-demo:cleanup": "corepack pnpm --filter @bbos/database seed:lab-demo:cleanup",
    "seed:cupping-mobile-demo": "corepack pnpm --filter @bbos/database seed:lab-demo"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
