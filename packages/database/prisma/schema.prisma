  reservations           InventoryReservation[]
  finishedGoodsMovements FinishedGoodsMovement[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([salesOrderId])
  @@index([productVariantId])
}

model InventoryReservation {
  id                     String                     @id @default(cuid())
  companyId              String
  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrderId           String
  salesOrder             SalesOrder                 @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  salesOrderItemId       String                     @unique
  salesOrderItem         SalesOrderItem             @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  productVariantId       String
  productVariant         ProductVariant             @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  finishedProductId      String
  finishedProduct        FinishedProduct            @relation(fields: [finishedProductId], references: [id], onDelete: Restrict)
  warehouseId            String
  warehouse              Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity               Int
  status                 InventoryReservationStatus @default(ACTIVE)
  idempotencyKey         String                     @unique
  releasedAt             DateTime?
  consumedAt             DateTime?
  finishedGoodsMovements FinishedGoodsMovement[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([productVariantId, status])
  @@index([salesOrderId, status])
  @@index([finishedProductId, status])
}

model IndustrialEvent {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  coffeeLotId       String?
  coffeeLot         CoffeeLot?       @relation(fields: [coffeeLotId], references: [id])
  warehouseId       String?
  warehouse         Warehouse?       @relation(fields: [warehouseId], references: [id])
  type              EventType
  quantityKg        Decimal?         @db.Decimal(14, 3)
  metadata          Json?
  occurredAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@index([companyId, occurredAt])
  @@index([productionOrderId])
}

model CostEvent {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  coffeeLotId       String?
  coffeeLot         CoffeeLot?          @relation(fields: [coffeeLotId], references: [id])
  blendId           String?
  blend             Blend?              @relation(fields: [blendId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  productVariantId  String?
  productVariant    ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  finishedProductId String?
  finishedProduct   FinishedProduct?    @relation(fields: [finishedProductId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  type              CostType
  nature            CostNature          @default(DIRECT)
  costCenterId      String?
  costCenter        CostCenter?         @relation(fields: [costCenterId], references: [id])
  allocationRuleId  String?
  allocationRule    AllocationRule?     @relation(fields: [allocationRuleId], references: [id])
  supplierId        String?
  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  resourceId        String?
  resource          ProductiveResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  amount            Decimal             @db.Decimal(14, 2)
  quantityBasis     Decimal?            @db.Decimal(14, 3)
  unit              String?
  description       String
  notes             String?
  competenceAt      DateTime?
  occurredAt        DateTime            @default(now())
  createdAt         DateTime            @default(now())

  @@index([companyId, occurredAt])
  @@index([productVariantId, occurredAt])
  @@index([supplierId, resourceId])
  @@index([costCenterId, nature, occurredAt])
  @@index([coffeeLotId, blendId, productionOrderId, finishedProductId, salesOrderId])
}

model CostCenter {
  id                    String                 @id @default(cuid())
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  category              CostCenterCategory
  description           String
  active                Boolean                @default(true)
  allocationMethod      AllocationMethod
  monthlyBudget         Decimal                @default(0) @db.Decimal(14, 2)
  costEvents            CostEvent[]
  resources             ProductiveResource[]
  allocationRules       AllocationRule[]
  tariffs               CostTariff[]
  accountsPayable       AccountsPayable[]
  financialTransactions FinancialTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([companyId, code])
  @@index([companyId, category, active])
}

model ProductiveResource {
  id                      String                    @id @default(cuid())
  companyId               String
  company                 Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenterId            String
  costCenter              CostCenter                @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  name                    String
  code                    String
  purchaseValue           Decimal                   @db.Decimal(14, 2)
  residualValue           Decimal                   @default(0) @db.Decimal(14, 2)
  usefulLifeMonths        Int
  expectedProductiveHours Decimal                   @db.Decimal(14, 3)
  maintenanceCostEstimate Decimal                   @default(0) @db.Decimal(14, 2)
  energyConsumption       Decimal                   @default(0) @db.Decimal(14, 4)
  energyRatePerKwh        Decimal                   @default(0) @db.Decimal(14, 4)
  gasConsumption          Decimal                   @default(0) @db.Decimal(14, 4)
  gasRatePerUnit          Decimal                   @default(0) @db.Decimal(14, 4)
  otherHourlyCost         Decimal                   @default(0) @db.Decimal(14, 4)
  active                  Boolean                   @default(true)
  productionUsages        ProductionResourceUsage[]
  costEvents              CostEvent[]
  tariffs                 CostTariff[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([costCenterId, active])
}

model ProductionResourceUsage {
  id                String             @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  resourceId        String
  resource          ProductiveResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  machineHours      Decimal            @default(0) @db.Decimal(14, 3)
  laborHours        Decimal            @default(0) @db.Decimal(14, 3)
  measuredEnergy    Decimal?           @db.Decimal(14, 4)
  measuredGas       Decimal?           @db.Decimal(14, 4)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([productionOrderId, resourceId])
  @@index([resourceId, createdAt])
}

model AllocationPeriod {
  id           String                    @id @default(cuid())
  companyId    String
  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String?
  startsAt     DateTime
  endsAt       DateTime
  status       AllocationPeriodStatus    @default(OPEN)
  calculatedAt DateTime?
  closedAt     DateTime?
  rules        AllocationRule[]
  snapshots    CostCalculationSnapshot[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status, startsAt])
}

model AllocationRule {
  id           String               @id @default(cuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenterId String
  costCenter   CostCenter           @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  periodId     String
  period       AllocationPeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  origin       String
  method       AllocationMethod
  baseAmount   Decimal              @db.Decimal(14, 4)
  destinations Json
  results      Json?
  status       AllocationRuleStatus @default(DRAFT)
  appliedAt    DateTime?
  costEvents   CostEvent[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([companyId, periodId, status])
  @@index([costCenterId, method])
}

model CostCalculationSnapshot {
  id                           String            @id @default(cuid())
  companyId                    String
  company                      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId            String?
  productionOrder              ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  productVariantId             String?
  productVariant               ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  periodCode                   String
  periodId                     String?
  period                       AllocationPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  calculationVersion           String            @default("cost-engine-v2")
  directCost                   Decimal           @db.Decimal(14, 4)
  industrialCost               Decimal           @db.Decimal(14, 4)
  corporateAllocation          Decimal           @default(0) @db.Decimal(14, 4)
  absorbedCost                 Decimal           @db.Decimal(14, 4)
  costPerUnit                  Decimal           @db.Decimal(14, 4)
  costPerKg                    Decimal           @db.Decimal(14, 4)
  absorbedCostPerUnit          Decimal?          @db.Decimal(14, 4)
  absorbedCostPerKg            Decimal?          @db.Decimal(14, 4)
  netRevenue                   Decimal?          @db.Decimal(14, 4)
  grossMarginPercent           Decimal?          @db.Decimal(9, 4)
  industrialMarginPercent      Decimal?          @db.Decimal(9, 4)
  contributionMarginPercent    Decimal?          @db.Decimal(9, 4)
  afterAllocationMarginPercent Decimal?          @db.Decimal(9, 4)
  profitPerUnit                Decimal?          @db.Decimal(14, 4)
  profitPerKg                  Decimal?          @db.Decimal(14, 4)
  composition                  Json
  sourceIds                    Json
  createdAt                    DateTime          @default(now())

  @@index([companyId, periodCode])
  @@index([periodId])
  @@index([productionOrderId, productVariantId])
}

model CostTariff {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         CostTariffType
  name         String
  unit         String
  value        Decimal             @db.Decimal(14, 6)
  validFrom    DateTime
  validUntil   DateTime?
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenterId String
  costCenter   CostCenter          @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  resourceId   String?
  resource     ProductiveResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([companyId, type, validFrom])
  @@index([costCenterId, active])
}

model LabSample {
  id          String                 @id @default(cuid())
  companyId   String
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lotId       String
  lot         CoffeeLot              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  sampleCode  String
  sampleType  LabSampleType          @default(ENTRY)
  status      LabSampleStatus        @default(PENDING)
  notes       String?
  createdById String
  createdBy   User                   @relation("SampleCreator", fields: [createdById], references: [id])
  sessions    CuppingSessionSample[]
  evaluations CuppingEvaluation[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([companyId, sampleCode])
  @@index([lotId, status])
}

model CuppingSession {
  id              String                 @id @default(cuid())
  companyId       String
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String
  status          CuppingSessionStatus   @default(DRAFT)
  mode            CuppingSessionMode     @default(CUPPING)
  startedAt       DateTime?
  closedAt        DateTime?
  coordinatorId   String
  coordinator     User                   @relation("SessionCoordinator", fields: [coordinatorId], references: [id])
  protocol        CuppingProtocol        @default(TRADITIONAL_100)
  protocolVersion String                 @default("1.0")
  accessToken     String?                @unique
  accessExpiresAt DateTime?
  notes           String?
  samples         CuppingSessionSample[]
  participants    CuppingParticipant[]
  evaluations     CuppingEvaluation[]
  decisions       CuppingDecision[]
  invitations     CuppingInvitation[]
  profiles        SensoryProfile[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
}

model CuppingSessionSample {
  id        String         @id @default(cuid())
  sessionId String
  session   CuppingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sampleId  String
  sample    LabSample      @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  position  Int            @default(0)
  createdAt DateTime       @default(now())

  @@unique([sessionId, sampleId])
}

model CuppingParticipant {
  id          String                 @id @default(cuid())
  sessionId   String
  session     CuppingSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation(fields: [userId], references: [id])
  role        CuppingParticipantRole @default(CUPPER)
  status      CuppingParticipantStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  joinedAt    DateTime               @default(now())
  evaluations CuppingEvaluation[]
  invitations CuppingInvitation[]

  @@unique([sessionId, userId])
}

model CuppingEvaluation {
  id              String                        @id @default(cuid())
  companyId       String
  company         Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessionId       String
  session         CuppingSession                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sampleId        String
  sample          LabSample                     @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  participantId   String
  participant     CuppingParticipant            @relation(fields: [participantId], references: [id], onDelete: Cascade)
  authorId        String
  author          User                          @relation("EvaluationAuthor", fields: [authorId], references: [id])
  fragrance       Decimal?                      @db.Decimal(5, 2)
  flavor          Decimal?                      @db.Decimal(5, 2)
  finish          Decimal?                      @db.Decimal(5, 2)
  acidity         Decimal?                      @db.Decimal(5, 2)
  body            Decimal?                      @db.Decimal(5, 2)
  balance         Decimal?                      @db.Decimal(5, 2)
  sweetness       Decimal?                      @db.Decimal(5, 2)
  uniformity      Decimal?                      @db.Decimal(5, 2)
  cleanliness     Decimal?                      @db.Decimal(5, 2)
  overall         Decimal?                      @db.Decimal(5, 2)
  rawScore        Decimal?                      @db.Decimal(5, 2)
  defectPenalty   Decimal?                      @db.Decimal(5, 2)
  finalScore      Decimal?                      @db.Decimal(5, 2)
  totalScore      Decimal?                      @db.Decimal(5, 2)
  acidityType     String?
  bodyType        String?
  aftertastePersistence String?
  affectiveMemory String?
  finalImpression String?
  stageData       Json?
  notes           String?
  status          CuppingEvaluationStatus       @default(DRAFT)
  cupStates       Json?
  autosaveVersion Int                           @default(1)
  savedAt         DateTime                      @updatedAt
  finalizedAt     DateTime?
  reopenedAt      DateTime?
  reopenedById    String?
  descriptors     CuppingEvaluationDescriptor[]
  descriptorSelections CuppingDescriptorSelection[]
  cupEvaluations  CuppingCupEvaluation[]
  createdAt       DateTime                      @default(now())

  @@unique([sessionId, sampleId, participantId])
  @@index([companyId, sessionId])
}

model CuppingDescriptorSelection {
  id           String                   @id @default(cuid())
  evaluationId String
  evaluation   CuppingEvaluation        @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  context      CuppingDescriptorContext
  family       String
  subfamily    String?
  descriptor   String?
  level        Int
  intensity    Int
  imageKey     String?
  createdAt    DateTime                 @default(now())

  @@index([evaluationId, context])
}

model CuppingCupEvaluation {
  id           String              @id @default(cuid())
  evaluationId String
  evaluation   CuppingEvaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  attribute    CuppingCupAttribute
  cupNumber    Int
  selected     Boolean             @default(true)
  notes        String?
  defect       CuppingCupDefect?

  @@unique([evaluationId, attribute, cupNumber])
}

model CuppingCupDefect {
  id              String               @id @default(cuid())
  cupEvaluationId String               @unique
  cupEvaluation   CuppingCupEvaluation @relation(fields: [cupEvaluationId], references: [id], onDelete: Cascade)
  defectType      String
  defectSeverity  CuppingDefectSeverity
  defectDescription String?
  notes           String?
  createdAt       DateTime             @default(now())
}

model CuppingInvitation {
  id            String             @id @default(cuid())
  sessionId     String
  session       CuppingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   CuppingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  tokenHash     String             @unique
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime           @default(now())

  @@index([sessionId, participantId, expiresAt])
}

model CuppingDescriptor {
  id          String                        @id @default(cuid())
  companyId   String
  company     Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  category    String
  type        String                        @default("FLAVOR")
  group       String?
  subgroup    String?
  parentId    String?
  source      String                        @default("SCA_REFERENCE")
  sortOrder   Int                           @default(0)
  active      Boolean                       @default(true)
  evaluations CuppingEvaluationDescriptor[]
  createdAt   DateTime                      @default(now())

  @@unique([companyId, name])
}

model CuppingEvaluationDescriptor {
  evaluationId String
  evaluation   CuppingEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  descriptorId String
  descriptor   CuppingDescriptor @relation(fields: [descriptorId], references: [id], onDelete: Restrict)

  @@id([evaluationId, descriptorId])
}

model CuppingDecision {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lotId        String
  lot          CoffeeLot           @relation(fields: [lotId], references: [id], onDelete: Restrict)
  sessionId    String
  session      CuppingSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  decision     CuppingDecisionType
  decisionAt   DateTime            @default(now())
  decisionById String
  decisionBy   User                @relation("DecisionAuthor", fields: [decisionById], references: [id])
  notes        String?
  createdAt    DateTime            @default(now())

  @@index([lotId, decisionAt])
}

model SensoryProfile {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lotId        String
  lot          CoffeeLot       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  sessionId    String?
  session      CuppingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  score        Decimal?        @db.Decimal(5, 2)
  attributes   Json
  acidityTypes Json
  descriptors  Json
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([lotId, createdAt])
}
