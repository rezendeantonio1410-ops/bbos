  code                    String
  purchaseValue           Decimal                   @db.Decimal(14, 2)
  residualValue           Decimal                   @default(0) @db.Decimal(14, 2)
  usefulLifeMonths        Int
  expectedProductiveHours Decimal                   @db.Decimal(14, 3)
  maintenanceCostEstimate Decimal                   @default(0) @db.Decimal(14, 2)
  energyConsumption       Decimal                   @default(0) @db.Decimal(14, 4)
  energyRatePerKwh        Decimal                   @default(0) @db.Decimal(14, 4)
  gasConsumption          Decimal                   @default(0) @db.Decimal(14, 4)
  gasRatePerUnit          Decimal                   @default(0) @db.Decimal(14, 4)
  otherHourlyCost         Decimal                   @default(0) @db.Decimal(14, 4)
  active                  Boolean                   @default(true)
  productionUsages        ProductionResourceUsage[]
  costEvents              CostEvent[]
  tariffs                 CostTariff[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([costCenterId, active])
}

model ProductionResourceUsage {
  id                String             @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  resourceId        String
  resource          ProductiveResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  machineHours      Decimal            @default(0) @db.Decimal(14, 3)
  laborHours        Decimal            @default(0) @db.Decimal(14, 3)
  measuredEnergy    Decimal?           @db.Decimal(14, 4)
  measuredGas       Decimal?           @db.Decimal(14, 4)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([productionOrderId, resourceId])
  @@index([resourceId, createdAt])
}

model AllocationPeriod {
  id           String                    @id @default(cuid())
  companyId    String
  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String?
  startsAt     DateTime
  endsAt       DateTime
  status       AllocationPeriodStatus    @default(OPEN)
  calculatedAt DateTime?
  closedAt     DateTime?
  rules        AllocationRule[]
  snapshots    CostCalculationSnapshot[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status, startsAt])
}

model AllocationRule {
  id           String               @id @default(cuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenterId String
  costCenter   CostCenter           @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  periodId     String
  period       AllocationPeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  origin       String
  method       AllocationMethod
  baseAmount   Decimal              @db.Decimal(14, 4)
  destinations Json
  results      Json?
  status       AllocationRuleStatus @default(DRAFT)
  appliedAt    DateTime?
  costEvents   CostEvent[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([companyId, periodId, status])
  @@index([costCenterId, method])
}

model CostCalculationSnapshot {
  id                           String            @id @default(cuid())
  companyId                    String
  company                      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId            String?
  productionOrder              ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  productVariantId             String?
  productVariant               ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  periodCode                   String
  periodId                     String?
  period                       AllocationPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  calculationVersion           String            @default("cost-engine-v2")
  directCost                   Decimal           @db.Decimal(14, 4)
  industrialCost               Decimal           @db.Decimal(14, 4)
  corporateAllocation          Decimal           @default(0) @db.Decimal(14, 4)
  absorbedCost                 Decimal           @db.Decimal(14, 4)
  costPerUnit                  Decimal           @db.Decimal(14, 4)
  costPerKg                    Decimal           @db.Decimal(14, 4)
  absorbedCostPerUnit          Decimal?          @db.Decimal(14, 4)
  absorbedCostPerKg            Decimal?          @db.Decimal(14, 4)
  netRevenue                   Decimal?          @db.Decimal(14, 4)
  grossMarginPercent           Decimal?          @db.Decimal(9, 4)
  industrialMarginPercent      Decimal?          @db.Decimal(9, 4)
  contributionMarginPercent    Decimal?          @db.Decimal(9, 4)
  afterAllocationMarginPercent Decimal?          @db.Decimal(9, 4)
  profitPerUnit                Decimal?          @db.Decimal(14, 4)
  profitPerKg                  Decimal?          @db.Decimal(14, 4)
  composition                  Json
  sourceIds                    Json
  createdAt                    DateTime          @default(now())

  @@index([companyId, periodCode])
  @@index([periodId])
  @@index([productionOrderId, productVariantId])
}

model CostTariff {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         CostTariffType
  name         String
  unit         String
  value        Decimal             @db.Decimal(14, 6)
  validFrom    DateTime
  validUntil   DateTime?
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenterId String
  costCenter   CostCenter          @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  resourceId   String?
  resource     ProductiveResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([companyId, type, validFrom])
  @@index([costCenterId, active])
}
