generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EXECUTIVE
  INDUSTRIAL
  FINANCE
  SALES
}

enum CoffeeLotStatus {
  RECEIVED
  QUALITY_REVIEW
  APPROVED
  BLOCKED
  CONSUMED
}

enum ProductionStatus {
  PLANNED
  RESERVED
  IN_PROGRESS
  ROASTED
  PACKAGING
  COMPLETED
  BLOCKED
  CANCELLED
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FinishedGoodsMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  PRODUCTION_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  LOSS_OUT
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  RESERVED
  PICKING
  READY_TO_SHIP
  INVOICED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum FinancialAccountType {
  CASH
  BANK
  DIGITAL_ACCOUNT
  OTHER
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum FinancialTransactionType {
  RECEIPT
  PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum ProductLineCode {
  RAROS
  EPICOS
  CLASSICOS
  GOURMET
}

enum EventType {
  RECEIPT
  QUALITY_TEST
  TRANSFER
  ROAST
  GRIND
  PACK
  LOSS
  ADJUSTMENT
}

enum CostType {
  RAW_MATERIAL
  FREIGHT
  LABOR
  ENERGY
  GAS
  PACKAGING
  LABEL
  VALVE
  BOX
  SUPPLIES
  DEPRECIATION
  MAINTENANCE
  RENT
  LOGISTICS
  TECHNOLOGY
  ADMINISTRATIVE
  COMMERCIAL
  TAX
  OVERHEAD
  OTHER
}

enum CostNature {
  DIRECT
  INDIRECT_INDUSTRIAL
  CORPORATE
}

enum CostCenterCategory {
  INDUSTRIAL
  LOGISTICS_INVENTORY
  CORPORATE
}

enum AllocationMethod {
  KG_PRODUCED
  MACHINE_HOURS
  LABOR_HOURS
  ENERGY_CONSUMPTION
  AREA
  REVENUE
  FIXED_PERCENTAGE
  UNITS_PRODUCED
}

enum AllocationPeriodStatus {
  OPEN
  CALCULATING
  REVIEW
  CALCULATED
  CLOSED
}

enum CostTariffType {
  ENERGY
  GAS
  LABOR
  OTHER
}

enum AllocationRuleStatus {
  DRAFT
  ACTIVE
  APPLIED
  CANCELLED
}

model Company {
  id                     String                    @id @default(cuid())
  name                   String
  tradeName              String
  taxId                  String                    @unique
  currency               String                    @default("BRL")
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  users                  User[]
  suppliers              Supplier[]
  customers              Customer[]
  coffeeLots             CoffeeLot[]
  warehouses             Warehouse[]
  blends                 Blend[]
  productionOrders       ProductionOrder[]
  products               FinishedProduct[]
  productLines           ProductLine[]
  salesOrders            SalesOrder[]
  industrialEvents       IndustrialEvent[]
  costEvents             CostEvent[]
  productionBatches      ProductionBatch[]
  productionConsumptions ProductionConsumption[]
  packagingConsumptions  PackagingConsumption[]
  finishedGoodsMovements FinishedGoodsMovement[]
  salesOrderItems        SalesOrderItem[]
  inventoryReservations  InventoryReservation[]
  costCenters            CostCenter[]
  productiveResources    ProductiveResource[]
  allocationPeriods      AllocationPeriod[]
  allocationRules        AllocationRule[]
  costSnapshots          CostCalculationSnapshot[]
  costTariffs            CostTariff[]
  financialAccounts      FinancialAccount[]
  accountsReceivable     AccountsReceivable[]
  accountsPayable        AccountsPayable[]
  financialTransactions  FinancialTransaction[]
  payments               Payment[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(INDUSTRIAL)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model Supplier {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  taxId       String?
  city        String?
  state       String?
  coffeeLots  CoffeeLot[]
  costEvents  CostEvent[]
  costTariffs CostTariff[]
  accountsPayable AccountsPayable[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
}

model Customer {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  taxId       String?
  segment     String?
  salesOrders SalesOrder[]
  accountsReceivable AccountsReceivable[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
}

model Warehouse {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String
  code                   String
  type                   String
  coffeeLots             CoffeeLot[]
  finishedProducts       FinishedProduct[]
  industrialEvents       IndustrialEvent[]
  finishedGoodsMovements FinishedGoodsMovement[]
  inventoryReservations  InventoryReservation[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([companyId, code])
}

model CoffeeLot {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId             String
  supplier               Supplier                @relation(fields: [supplierId], references: [id])
  warehouseId            String
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id])
  code                   String
  origin                 String
  harvest                String?
  variety                String?
  qualityScore           Decimal?                @db.Decimal(5, 2)
  initialWeightKg        Decimal                 @db.Decimal(14, 3)
  currentWeightKg        Decimal                 @db.Decimal(14, 3)
  reservedWeightKg       Decimal                 @default(0) @db.Decimal(14, 3)
  purchaseCost           Decimal                 @db.Decimal(14, 2)
  landedCost             Decimal                 @db.Decimal(14, 2)
  status                 CoffeeLotStatus         @default(RECEIVED)
  blendComponents        BlendComponent[]
  industrialEvents       IndustrialEvent[]
  costEvents             CostEvent[]
  productionConsumptions ProductionConsumption[]
  receivedAt             DateTime                @default(now())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([companyId, code])
  @@index([supplierId, warehouseId])
}

model Blend {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  code             String
  version          Int               @default(1)
  active           Boolean           @default(true)
  components       BlendComponent[]
  productionOrders ProductionOrder[]
  products         FinishedProduct[]
  costEvents       CostEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([companyId, code, version])
}

model BlendComponent {
  id          String    @id @default(cuid())
  blendId     String
  blend       Blend     @relation(fields: [blendId], references: [id], onDelete: Cascade)
  coffeeLotId String
  coffeeLot   CoffeeLot @relation(fields: [coffeeLotId], references: [id])
  percentage  Decimal   @db.Decimal(5, 2)
  createdAt   DateTime  @default(now())

  @@unique([blendId, coffeeLotId])
}

model ProductionOrder {
  id                     String                    @id @default(cuid())
  companyId              String
  company                Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  blendId                String?
  blend                  Blend?                    @relation(fields: [blendId], references: [id])
  productVariantId       String?
  productVariant         ProductVariant?           @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  code                   String
  productName            String                    @default("Produto não definido")
  sku                    String                    @default("SKU-PENDENTE")
  unit                   String                    @default("kg")
  responsible            String                    @default("Não atribuído")
  priority               ProductionPriority        @default(NORMAL)
  status                 ProductionStatus          @default(PLANNED)
  plannedWeightKg        Decimal                   @db.Decimal(14, 3)
  actualInputKg          Decimal?                  @db.Decimal(14, 3)
  actualOutputKg         Decimal?                  @db.Decimal(14, 3)
  plannedAt              DateTime
  startedAt              DateTime?
  completedAt            DateTime?
  industrialEvents       IndustrialEvent[]
  costEvents             CostEvent[]
  productLots            FinishedProduct[]
  batches                ProductionBatch[]
  consumptions           ProductionConsumption[]
  packagingConsumptions  PackagingConsumption[]
  finishedGoodsMovements FinishedGoodsMovement[]
  resourceUsages         ProductionResourceUsage[]
  costSnapshots          CostCalculationSnapshot[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([blendId, status])
  @@index([productVariantId, status])
}

model ProductionBatch {
  id                String                  @id @default(cuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder         @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  code              String
  machine           String
  operator          String
  greenInputKg      Decimal                 @db.Decimal(14, 3)
  roastedOutputKg   Decimal                 @db.Decimal(14, 3)
  lossKg            Decimal                 @db.Decimal(14, 3)
  lossPercent       Decimal                 @db.Decimal(7, 3)
  startedAt         DateTime
  completedAt       DateTime
  curveData         Json?
  notes             String?
  consumptions      ProductionConsumption[]
  createdAt         DateTime                @default(now())

  @@unique([productionOrderId, code])
  @@index([companyId, completedAt])
}

model ProductionConsumption {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionBatchId String?
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id])
  coffeeLotId       String
  coffeeLot         CoffeeLot        @relation(fields: [coffeeLotId], references: [id])
  reservedKg        Decimal          @db.Decimal(14, 3)
  consumedKg        Decimal          @default(0) @db.Decimal(14, 3)
  percentage        Decimal          @db.Decimal(7, 3)
  realCostPerKg     Decimal          @db.Decimal(14, 4)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([productionOrderId, coffeeLotId])
  @@index([coffeeLotId])
}

model PackagingConsumption {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  materialType      String
  materialName      String
  sku               String?
  quantity          Decimal         @db.Decimal(14, 3)
  unit              String
  unitCost          Decimal         @db.Decimal(14, 4)
  totalCost         Decimal         @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())

  @@index([productionOrderId])
}

model FinishedGoodsMovement {
  id                String                    @id @default(cuid())
  companyId         String
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String?
  productionOrder   ProductionOrder?          @relation(fields: [productionOrderId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?               @relation(fields: [salesOrderId], references: [id])
  salesOrderItemId  String?
  salesOrderItem    SalesOrderItem?           @relation(fields: [salesOrderItemId], references: [id])
  reservationId     String?
  reservation       InventoryReservation?     @relation(fields: [reservationId], references: [id])
  productVariantId  String?
  productVariant    ProductVariant?           @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  finishedProductId String
  finishedProduct   FinishedProduct           @relation(fields: [finishedProductId], references: [id])
  warehouseId       String
  warehouse         Warehouse                 @relation(fields: [warehouseId], references: [id])
  type              FinishedGoodsMovementType
  packageQuantity   Int
  unit              String                    @default("UN")
  totalWeightKg     Decimal                   @db.Decimal(14, 3)
  sourceType        String?
  sourceId          String?
  idempotencyKey    String?                   @unique
  reason            String
  occurredAt        DateTime                  @default(now())
  createdAt         DateTime                  @default(now())

  @@index([productionOrderId, occurredAt])
  @@index([salesOrderId, occurredAt])
  @@index([productVariantId, occurredAt])
  @@index([finishedProductId, warehouseId])
}

model FinishedProduct {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  blendId                String?
  blend                  Blend?                  @relation(fields: [blendId], references: [id])
  productionOrderId      String?
  productionOrder        ProductionOrder?        @relation(fields: [productionOrderId], references: [id])
  productVariantId       String?
  productVariant         ProductVariant?         @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  warehouseId            String
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id])
  sku                    String
  name                   String
  line                   ProductLineCode         @default(CLASSICOS)
  packageWeightG         Int
  quantityOnHand         Int                     @default(0)
  reservedQuantity       Int                     @default(0)
  standardPrice          Decimal                 @db.Decimal(14, 2)
  salesOrders            SalesOrder[]
  costEvents             CostEvent[]
  finishedGoodsMovements FinishedGoodsMovement[]
  inventoryReservations  InventoryReservation[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([companyId, sku])
  @@unique([productVariantId, warehouseId])
  @@index([productVariantId])
}

model ProductLine {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        ProductLineCode
  name        String
  slug        String
  description String
  positioning String
  sortOrder   Int
  active      Boolean         @default(true)
  products    Product[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([companyId, slug])
  @@unique([companyId, code])
}

model Product {
  id            String           @id @default(cuid())
  productLineId String
  productLine   ProductLine      @relation(fields: [productLineId], references: [id], onDelete: Restrict)
  code          String
  name          String
  slug          String
  description   String
  active        Boolean          @default(true)
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([productLineId, slug])
  @@unique([productLineId, code])
}

model ProductVariant {
  id                     String                    @id @default(cuid())
  productId              String
  product                Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                    String                    @unique
  netWeightGrams         Int
  salesUnit              String
  active                 Boolean                   @default(true)
  coffeeCost             Decimal                   @default(0) @db.Decimal(14, 2)
  industrialCost         Decimal                   @default(0) @db.Decimal(14, 2)
  packagingCost          Decimal                   @default(0) @db.Decimal(14, 2)
  labelCost              Decimal                   @default(0) @db.Decimal(14, 2)
  boxCost                Decimal                   @default(0) @db.Decimal(14, 2)
  laborCost              Decimal                   @default(0) @db.Decimal(14, 2)
  energyCost             Decimal                   @default(0) @db.Decimal(14, 2)
  otherCost              Decimal                   @default(0) @db.Decimal(14, 2)
  totalCost              Decimal                   @default(0) @db.Decimal(14, 2)
  unitCost               Decimal                   @default(0) @db.Decimal(14, 2)
  marginPercent          Decimal                   @default(0) @db.Decimal(7, 3)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  costSnapshots          CostCalculationSnapshot[]
  productionOrders       ProductionOrder[]
  finishedProducts       FinishedProduct[]
  finishedGoodsMovements FinishedGoodsMovement[]
  salesOrderItems        SalesOrderItem[]
  inventoryReservations  InventoryReservation[]
  costEvents             CostEvent[]

  @@unique([productId, netWeightGrams])
  @@index([productId, active])
}

model SalesOrder {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer                @relation(fields: [customerId], references: [id])
  finishedProductId      String?
  finishedProduct        FinishedProduct?        @relation(fields: [finishedProductId], references: [id])
  code                   String
  orderNumber            String?
  status                 SalesOrderStatus        @default(DRAFT)
  quantity               Int
  unitPrice              Decimal                 @db.Decimal(14, 2)
  totalAmount            Decimal                 @db.Decimal(14, 2)
  orderedAt              DateTime                @default(now())
  orderDate              DateTime?
  expectedDeliveryDate   DateTime?
  subtotal               Decimal?                @db.Decimal(14, 2)
  discount               Decimal                 @default(0) @db.Decimal(14, 2)
  freight                Decimal                 @default(0) @db.Decimal(14, 2)
  notes                  String?
  invoicedAt             DateTime?
  deliveredAt            DateTime?
  costEvents             CostEvent[]
  items                  SalesOrderItem[]
  reservations           InventoryReservation[]
  finishedGoodsMovements FinishedGoodsMovement[]
  accountsReceivable     AccountsReceivable[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([companyId, code])
  @@index([customerId, status])
}

model FinancialAccount {
  id                     String                   @id @default(cuid())
  companyId              String
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String
  type                   FinancialAccountType
  currency               String                   @default("BRL")
  openingBalance         Decimal                  @default(0) @db.Decimal(14, 2)
  active                 Boolean                  @default(true)
  transactions           FinancialTransaction[]
  payments               Payment[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([companyId, active])
}

model AccountsReceivable {
  id                     String                   @id @default(cuid())
  companyId              String
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrderId           String?
  salesOrder             SalesOrder?              @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  invoiceId              String?
  issueDate              DateTime
  dueDate                DateTime
  amount                 Decimal                  @db.Decimal(14, 2)
  openAmount             Decimal                  @db.Decimal(14, 2)
  status                 ReceivableStatus         @default(OPEN)
  paymentDate            DateTime?
  notes                  String?
  payments               Payment[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([companyId, status, dueDate])
  @@index([customerId, dueDate])
  @@unique([salesOrderId])
}

model AccountsPayable {
  id                     String                   @id @default(cuid())
  companyId              String
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId             String?
  supplier               Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenterId           String?
  costCenter             CostCenter?               @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  description            String
  issueDate              DateTime
  dueDate                DateTime
  amount                 Decimal                  @db.Decimal(14, 2)
  openAmount             Decimal                  @db.Decimal(14, 2)
  status                 PayableStatus             @default(OPEN)
  category               String
  paymentDate            DateTime?
  notes                  String?
  payments               Payment[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([companyId, status, dueDate])
  @@index([costCenterId, dueDate])
}

model Payment {
  id                     String                   @id @default(cuid())
  companyId              String
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountsReceivableId   String?
  accountsReceivable     AccountsReceivable?      @relation(fields: [accountsReceivableId], references: [id], onDelete: SetNull)
  accountsPayableId      String?
  accountsPayable        AccountsPayable?         @relation(fields: [accountsPayableId], references: [id], onDelete: SetNull)
  financialAccountId     String
  financialAccount       FinancialAccount         @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  amount                 Decimal                  @db.Decimal(14, 2)
  paidAt                 DateTime
  method                 String
  notes                  String?
  idempotencyKey         String                   @unique
  transaction            FinancialTransaction?
  createdAt              DateTime                 @default(now())

  @@index([companyId, paidAt])
}

model FinancialTransaction {
  id                     String                   @id @default(cuid())
  companyId              String
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialAccountId     String
  financialAccount       FinancialAccount         @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  paymentId              String?                  @unique
  payment               Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  costCenterId           String?
  costCenter             CostCenter?              @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  type                   FinancialTransactionType
  amount                 Decimal                  @db.Decimal(14, 2)
  category               String
  description            String
  occurredAt             DateTime                 @default(now())
  createdAt              DateTime                 @default(now())

  @@index([companyId, occurredAt])
  @@index([financialAccountId, occurredAt])
}

model SalesOrderItem {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrderId           String
  salesOrder             SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productVariantId       String
  productVariant         ProductVariant          @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  productName            String
  sku                    String
  quantity               Int
  pickedQuantity         Int                     @default(0)
  pickedAt               DateTime?
  unitPrice              Decimal                 @db.Decimal(14, 2)
  discount               Decimal                 @default(0) @db.Decimal(14, 2)
  totalAmount            Decimal                 @db.Decimal(14, 2)
  reservations           InventoryReservation[]
  finishedGoodsMovements FinishedGoodsMovement[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([salesOrderId])
  @@index([productVariantId])
}

model InventoryReservation {
  id                     String                     @id @default(cuid())
  companyId              String
  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrderId           String
  salesOrder             SalesOrder                 @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  salesOrderItemId       String                     @unique
  salesOrderItem         SalesOrderItem             @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  productVariantId       String
  productVariant         ProductVariant             @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  finishedProductId      String
  finishedProduct        FinishedProduct            @relation(fields: [finishedProductId], references: [id], onDelete: Restrict)
  warehouseId            String
  warehouse              Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity               Int
  status                 InventoryReservationStatus @default(ACTIVE)
  idempotencyKey         String                     @unique
  releasedAt             DateTime?
  consumedAt             DateTime?
  finishedGoodsMovements FinishedGoodsMovement[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([productVariantId, status])
  @@index([salesOrderId, status])
  @@index([finishedProductId, status])
}

model IndustrialEvent {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  coffeeLotId       String?
  coffeeLot         CoffeeLot?       @relation(fields: [coffeeLotId], references: [id])
  warehouseId       String?
  warehouse         Warehouse?       @relation(fields: [warehouseId], references: [id])
  type              EventType
  quantityKg        Decimal?         @db.Decimal(14, 3)
  metadata          Json?
  occurredAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@index([companyId, occurredAt])
  @@index([productionOrderId])
}

model CostEvent {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  coffeeLotId       String?
  coffeeLot         CoffeeLot?          @relation(fields: [coffeeLotId], references: [id])
  blendId           String?
  blend             Blend?              @relation(fields: [blendId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder?    @relation(fields: [productionOrderId], references: [id])
  productVariantId  String?
  productVariant    ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  finishedProductId String?
  finishedProduct   FinishedProduct?    @relation(fields: [finishedProductId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  type              CostType
  nature            CostNature          @default(DIRECT)
  costCenterId      String?
  costCenter        CostCenter?         @relation(fields: [costCenterId], references: [id])
  allocationRuleId  String?
  allocationRule    AllocationRule?     @relation(fields: [allocationRuleId], references: [id])
  supplierId        String?
  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  resourceId        String?
  resource          ProductiveResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  amount            Decimal             @db.Decimal(14, 2)
  quantityBasis     Decimal?            @db.Decimal(14, 3)
  unit              String?
  description       String
  notes             String?
  competenceAt      DateTime?
  occurredAt        DateTime            @default(now())
  createdAt         DateTime            @default(now())

  @@index([companyId, occurredAt])
  @@index([productVariantId, occurredAt])
  @@index([supplierId, resourceId])
  @@index([costCenterId, nature, occurredAt])
  @@index([coffeeLotId, blendId, productionOrderId, finishedProductId, salesOrderId])
}

model CostCenter {
  id               String               @id @default(cuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code             String
  name             String
  category         CostCenterCategory
  description      String
  active           Boolean              @default(true)
  allocationMethod AllocationMethod
  monthlyBudget    Decimal              @default(0) @db.Decimal(14, 2)
  costEvents       CostEvent[]
  resources        ProductiveResource[]
  allocationRules  AllocationRule[]
  tariffs          CostTariff[]
  accountsPayable  AccountsPayable[]
  financialTransactions FinancialTransaction[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([companyId, code])
  @@index([companyId, category, active])
}

model ProductiveResource {
  id                      String                    @id @default(cuid())
  companyId               String
  company                 Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenterId            String
  costCenter              CostCenter                @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  name                    String
  code                    String
  purchaseValue           Decimal                   @db.Decimal(14, 2)
  residualValue           Decimal                   @default(0) @db.Decimal(14, 2)
  usefulLifeMonths        Int
  expectedProductiveHours Decimal                   @db.Decimal(14, 3)
  maintenanceCostEstimate Decimal                   @default(0) @db.Decimal(14, 2)
  energyConsumption       Decimal                   @default(0) @db.Decimal(14, 4)
  energyRatePerKwh        Decimal                   @default(0) @db.Decimal(14, 4)
  gasConsumption          Decimal                   @default(0) @db.Decimal(14, 4)
  gasRatePerUnit          Decimal                   @default(0) @db.Decimal(14, 4)
  otherHourlyCost         Decimal                   @default(0) @db.Decimal(14, 4)
  active                  Boolean                   @default(true)
  productionUsages        ProductionResourceUsage[]
  costEvents              CostEvent[]
  tariffs                 CostTariff[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([costCenterId, active])
}

model ProductionResourceUsage {
  id                String             @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  resourceId        String
  resource          ProductiveResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  machineHours      Decimal            @default(0) @db.Decimal(14, 3)
  laborHours        Decimal            @default(0) @db.Decimal(14, 3)
  measuredEnergy    Decimal?           @db.Decimal(14, 4)
  measuredGas       Decimal?           @db.Decimal(14, 4)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([productionOrderId, resourceId])
  @@index([resourceId, createdAt])
}

model AllocationPeriod {
  id           String                    @id @default(cuid())
  companyId    String
  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String?
  startsAt     DateTime
  endsAt       DateTime
  status       AllocationPeriodStatus    @default(OPEN)
  calculatedAt DateTime?
  closedAt     DateTime?
  rules        AllocationRule[]
  snapshots    CostCalculationSnapshot[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status, startsAt])
}

model AllocationRule {
  id           String               @id @default(cuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenterId String
  costCenter   CostCenter           @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  periodId     String
  period       AllocationPeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  origin       String
  method       AllocationMethod
  baseAmount   Decimal              @db.Decimal(14, 4)
  destinations Json
  results      Json?
  status       AllocationRuleStatus @default(DRAFT)
  appliedAt    DateTime?
  costEvents   CostEvent[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([companyId, periodId, status])
  @@index([costCenterId, method])
}

model CostCalculationSnapshot {
  id                           String            @id @default(cuid())
  companyId                    String
  company                      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId            String?
  productionOrder              ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  productVariantId             String?
  productVariant               ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  periodCode                   String
  periodId                     String?
  period                       AllocationPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  calculationVersion           String            @default("cost-engine-v2")
  directCost                   Decimal           @db.Decimal(14, 4)
  industrialCost               Decimal           @db.Decimal(14, 4)
  corporateAllocation          Decimal           @default(0) @db.Decimal(14, 4)
  absorbedCost                 Decimal           @db.Decimal(14, 4)
  costPerUnit                  Decimal           @db.Decimal(14, 4)
  costPerKg                    Decimal           @db.Decimal(14, 4)
  absorbedCostPerUnit          Decimal?          @db.Decimal(14, 4)
  absorbedCostPerKg            Decimal?          @db.Decimal(14, 4)
  netRevenue                   Decimal?          @db.Decimal(14, 4)
  grossMarginPercent           Decimal?          @db.Decimal(9, 4)
  industrialMarginPercent      Decimal?          @db.Decimal(9, 4)
  contributionMarginPercent    Decimal?          @db.Decimal(9, 4)
  afterAllocationMarginPercent Decimal?          @db.Decimal(9, 4)
  profitPerUnit                Decimal?          @db.Decimal(14, 4)
  profitPerKg                  Decimal?          @db.Decimal(14, 4)
  composition                  Json
  sourceIds                    Json
  createdAt                    DateTime          @default(now())

  @@index([companyId, periodCode])
  @@index([periodId])
  @@index([productionOrderId, productVariantId])
}

model CostTariff {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type         CostTariffType
  name         String
  unit         String
  value        Decimal             @db.Decimal(14, 6)
  validFrom    DateTime
  validUntil   DateTime?
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costCenterId String
  costCenter   CostCenter          @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  resourceId   String?
  resource     ProductiveResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([companyId, type, validFrom])
  @@index([costCenterId, active])
}
