generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EXECUTIVE
  INDUSTRIAL
  FINANCE
  SALES
}

enum CoffeeLotStatus {
  RECEIVED
  QUALITY_REVIEW
  APPROVED
  BLOCKED
  CONSUMED
}

enum ProductionStatus {
  PLANNED
  RESERVED
  IN_PROGRESS
  ROASTED
  PACKAGING
  COMPLETED
  BLOCKED
  CANCELLED
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FinishedGoodsMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  PRODUCTION_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  LOSS_OUT
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  RESERVED
  PICKING
  READY_TO_SHIP
  INVOICED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SalesChannelType {
  ECOMMERCE
  B2B
  DISTRIBUIDOR
  CAFETERIA
  ESCRITORIO
  EXPORTACAO
  OUTRO
}

enum PriceTableStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CommercialPromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CreditRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PENDING_DOCUMENTS
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CANCELLED
}

enum FinancialAccountType {
  CASH
  BANK
  DIGITAL_ACCOUNT
  OTHER
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum FinancialTransactionType {
  RECEIPT
  PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  PARTIALLY_MATCHED
  DIVERGENT
  IGNORED
}

enum ReconciliationDirection {
  IN
  OUT
}

enum BankTransactionDirection {
  CREDIT
  DEBIT
}

enum BankTransactionSource {
  MANUAL
  CSV
  OFX
  API
  OPEN_BANKING
  OTHER
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum ProductLineCode {
  RAROS
  EPICOS
  CLASSICOS
  GOURMET
}

enum EventType {
  RECEIPT
  QUALITY_TEST
  TRANSFER
  ROAST
  GRIND
  PACK
  LOSS
  ADJUSTMENT
}

enum CostType {
  RAW_MATERIAL
  FREIGHT
  LABOR
  ENERGY
  GAS
  PACKAGING
  LABEL
  VALVE
  BOX
  SUPPLIES
  DEPRECIATION
  MAINTENANCE
  RENT
  LOGISTICS
  TECHNOLOGY
  ADMINISTRATIVE
  COMMERCIAL
  TAX
  OVERHEAD
  OTHER
}

enum CostNature {
  DIRECT
  INDIRECT_INDUSTRIAL
  CORPORATE
}

enum CostCenterCategory {
  INDUSTRIAL
  LOGISTICS_INVENTORY
  CORPORATE
}

enum AllocationMethod {
  KG_PRODUCED
  MACHINE_HOURS
  LABOR_HOURS
  ENERGY_CONSUMPTION
  AREA
  REVENUE
  FIXED_PERCENTAGE
  UNITS_PRODUCED
}

enum AllocationPeriodStatus {
  OPEN
  CALCULATING
  REVIEW
  CALCULATED
  CLOSED
}

enum CostTariffType {
  ENERGY
  GAS
  LABOR
  OTHER
}

enum AllocationRuleStatus {
  DRAFT
  ACTIVE
  APPLIED
  CANCELLED
}

enum LabSampleType {
  ENTRY
  CONTROL
  RETEST
  PRE_PRODUCTION
  OTHER
}

enum LabSampleStatus {
  PENDING
  ASSIGNED
  EVALUATED
  CONSOLIDATED
  APPROVED
  BLOCKED
}

enum CuppingSessionStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  PAUSED
  CONSOLIDATING
  CLOSED
  CANCELLED
}

enum CuppingSessionMode {
  CUPPING
  TRAINING
}

enum CuppingProtocol {
  TRADITIONAL_100
  CVA_EXPERIENCE
}

enum CuppingDefectSeverity {
  TAINT
  FAULT
}

enum CuppingParticipantRole {
  COORDINATOR
  CUPPER
  OBSERVER
}

enum CuppingDecisionType {
  APPROVED
  APPROVED_WITH_OBSERVATION
  RETEST_REQUIRED
  REJECTED
}

enum CuppingEvaluationStatus {
  DRAFT
  COMPLETED
}

enum CuppingParticipantStatus {
  INVITED
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PreferredCuppingChannel {
  QR
  EMAIL
  SMS
  WHATSAPP
}

enum CuppingDescriptorContext {
  AROMA
  FLAVOR
  AFTERTASTE
  ACIDITY
  BODY
}

enum CuppingCupAttribute {
  UNIFORMITY
  SWEETNESS
  CLEAN_CUP
}

enum SalesPersonType {
  INTERNAL_SELLER
  FIELD_SELLER
  SALES_REPRESENTATIVE
  SALES_MANAGER
}

enum SalesPersonStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SalesTargetType {
  REVENUE
  VOLUME
  MARGIN
  NEW_CUSTOMERS
  PRODUCT
  MIX
}

enum SalesVisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SalesOpportunityStage {
  PROSPECT
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CommissionEntryStatus {
  ESTIMATED
  ACCRUED
  RELEASED
  PAID
  REVERSED
}

enum CommercialNotificationType {
  PRICE_CHANGED
  PROMOTION_STARTED
  PROMOTION_ENDING
  PRODUCT_AVAILABLE
  PRODUCT_UNAVAILABLE
  ORDER_STATUS_CHANGED
  COMMISSION_RELEASED
  TARGET_ALERT
  CUSTOMER_REACTIVATION
  CREDIT_SUBMITTED
  CREDIT_UNDER_REVIEW
  CREDIT_DOCUMENT_REQUESTED
  CREDIT_APPROVED
  CREDIT_PARTIALLY_APPROVED
  CREDIT_REJECTED
  DOCUMENT_REQUESTED
  DOCUMENT_RECEIVED
  DOCUMENT_REJECTED
}

model Company {
  id                      String                        @id @default(cuid())
  name                    String
  tradeName               String
  taxId                   String                        @unique
  currency                String                        @default("BRL")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  users                   User[]
  suppliers               Supplier[]
  customers               Customer[]
  coffeeLots              CoffeeLot[]
  warehouses              Warehouse[]
  blends                  Blend[]
  productionOrders        ProductionOrder[]
  products                FinishedProduct[]
  productLines            ProductLine[]
  salesOrders             SalesOrder[]
  industrialEvents        IndustrialEvent[]
  costEvents              CostEvent[]
  productionBatches       ProductionBatch[]
  productionConsumptions  ProductionConsumption[]
  packagingConsumptions   PackagingConsumption[]
  finishedGoodsMovements  FinishedGoodsMovement[]
  salesOrderItems         SalesOrderItem[]
  inventoryReservations   InventoryReservation[]
  costCenters             CostCenter[]
  productiveResources     ProductiveResource[]
  allocationPeriods       AllocationPeriod[]
  allocationRules         AllocationRule[]
  costSnapshots           CostCalculationSnapshot[]
  costTariffs             CostTariff[]
  financialAccounts       FinancialAccount[]
  salesChannels           SalesChannel[]
  productPrices           ProductPrice[]
  priceTables             PriceTable[]
  priceTableAssignments   SalesPriceTableAssignment[]
  commercialPromotions    CommercialPromotion[]
  accountsReceivable      AccountsReceivable[]
  accountsPayable         AccountsPayable[]
  financialTransactions   FinancialTransaction[]
  payments                Payment[]
  reconciliationItems     ReconciliationItem[]
  reconciliationEvents    ReconciliationEvent[]
  financialInstitutions   FinancialInstitution[]
  bankTransactions        BankTransaction[]
  salesPeople             SalesPerson[]
  customerPortfolios      CustomerPortfolioAssignment[]
  salesTargets            SalesTarget[]
  salesVisits             SalesVisit[]
  salesOpportunities      SalesOpportunity[]
  commissionPlans         CommissionPlan[]
  commissionEntries       CommissionEntry[]
  commercialNotifications CommercialNotification[]
  catalogDocuments       CommercialCatalogDocument[]
  labSamples              LabSample[]
  cuppingSessions         CuppingSession[]
  cuppingEvaluations      CuppingEvaluation[]
  cuppingDescriptors      CuppingDescriptor[]
  cuppingDecisions        CuppingDecision[]
  sensoryProfiles         SensoryProfile[]
  customerDocuments       CustomerDocument[]
  customerAddresses       CustomerAddress[]
  customerContacts        CustomerContact[]
  creditRequests          CreditRequest[]
  customerActivities      CustomerActivity[]
}

model User {
  id                        String                   @id @default(cuid())
  companyId                 String
  company                   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                      String
  email                     String                   @unique
  passwordHash              String
  role                      UserRole                 @default(INDUSTRIAL)
  active                    Boolean                  @default(true)
  phoneE164                 String?
  preferredCuppingChannel   PreferredCuppingChannel @default(QR)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  createdLabSamples         LabSample[]              @relation("SampleCreator")
  coordinatedSessions       CuppingSession[]         @relation("SessionCoordinator")
  cuppingParticipations     CuppingParticipant[]
  cuppingEvaluations        CuppingEvaluation[]      @relation("EvaluationAuthor")
  labDecisions              CuppingDecision[]        @relation("DecisionAuthor")
  salesPerson               SalesPerson?
  commercialNotifications   CommercialNotification[]
  catalogDocuments          CommercialCatalogDocument[]
  uploadedCustomerDocuments CustomerDocument[]
  reviewedCreditRequests    CreditRequest[]          @relation("CreditReviewer")
  customerActivities        CustomerActivity[]

  @@index([companyId])
}

model Supplier {
  id                  String               @id @default(cuid())
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  taxId               String?
  city                String?
  state               String?
  coffeeLots          CoffeeLot[]
  costEvents          CostEvent[]
  costTariffs         CostTariff[]
  accountsPayable     AccountsPayable[]
  reconciliationItems ReconciliationItem[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([companyId])
}

model Customer {
  id                    String                        @id @default(cuid())
  companyId             String
  company               Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  taxId                 String?
  segment               String?
  salesOrders           SalesOrder[]
  accountsReceivable    AccountsReceivable[]
  portfolioAssignments  CustomerPortfolioAssignment[]
  priceTableAssignments SalesPriceTableAssignment[]
  commercialPromotions  CommercialPromotion[]
  contacts              CustomerContact[]
  addresses             CustomerAddress[]
  documents             CustomerDocument[]
  creditRequests        CreditRequest[]
  activities            CustomerActivity[]
  salesVisits           SalesVisit[]
  opportunities         SalesOpportunity[]
  reconciliationItems   ReconciliationItem[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([companyId])
}

model CustomerContact {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String
  phone      String?
  whatsapp   String?
  email      String?
  primary    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, role])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  postalCode String?
  country    String   @default("BR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, type])
}

model CustomerDocument {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  name         String
  type         String
  storageKey   String
  mimeType     String?
  sizeBytes    Int?
  version      Int      @default(1)
  status       String   @default("RECEIVED")
  createdAt    DateTime @default(now())

  @@index([customerId, type, version])
}

model CreditRequest {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId           String
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestedById        String
  requestedBy          SalesPerson         @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById         String?
  reviewedBy           User?               @relation("CreditReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  status               CreditRequestStatus @default(DRAFT)
  requestedLimit       Decimal             @db.Decimal(14, 2)
  approvedLimit        Decimal?            @db.Decimal(14, 2)
  requestedTermDays    Int
  approvedTermDays     Int?
  expectedMonthlyBuy   Decimal?            @db.Decimal(14, 2)
  paymentMethod        String?
  commercialReferences String?
  justification        String?
  reviewNote           String?
  analystUserId        String?
  decisionReason       String?
  internalNotes        String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([companyId, status, createdAt])
  @@index([customerId, status])
}

model CustomerActivity {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type        String
  title       String
  description String?
  metadata    Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([customerId, occurredAt])
}

model Warehouse {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String
  code                   String
  type                   String
  coffeeLots             CoffeeLot[]
  finishedProducts       FinishedProduct[]
  industrialEvents       IndustrialEvent[]
  finishedGoodsMovements FinishedGoodsMovement[]
  inventoryReservations  InventoryReservation[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([companyId, code])
}

model CoffeeLot {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId             String
  supplier               Supplier                @relation(fields: [supplierId], references: [id])
  warehouseId            String
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id])
  code                   String
  origin                 String
  harvest                String?
  variety                String?
  qualityScore           Decimal?                @db.Decimal(5, 2)
  initialWeightKg        Decimal                 @db.Decimal(14, 3)
  currentWeightKg        Decimal                 @db.Decimal(14, 3)
  reservedWeightKg       Decimal                 @default(0) @db.Decimal(14, 3)
  purchaseCost           Decimal                 @db.Decimal(14, 2)
  landedCost             Decimal                 @db.Decimal(14, 2)
  status                 CoffeeLotStatus         @default(RECEIVED)
  blendComponents        BlendComponent[]
  industrialEvents       IndustrialEvent[]
  costEvents             CostEvent[]
  productionConsumptions ProductionConsumption[]
  receivedAt             DateTime                @default(now())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  labSamples             LabSample[]
  cuppingDecisions       CuppingDecision[]
  sensoryProfiles        SensoryProfile[]

  @@unique([companyId, code])
  @@index([supplierId, warehouseId])
}

model Blend {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  code             String
  version          Int               @default(1)
  active           Boolean           @default(true)
  components       BlendComponent[]
  productionOrders ProductionOrder[]
  products         FinishedProduct[]
  costEvents       CostEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([companyId, code, version])
}

model BlendComponent {
  id          String    @id @default(cuid())
  blendId     String
  blend       Blend     @relation(fields: [blendId], references: [id], onDelete: Cascade)
  coffeeLotId String
  coffeeLot   CoffeeLot @relation(fields: [coffeeLotId], references: [id])
  percentage  Decimal   @db.Decimal(5, 2)
  createdAt   DateTime  @default(now())

  @@unique([blendId, coffeeLotId])
}

model ProductionOrder {
  id                     String                    @id @default(cuid())
  companyId              String
  company                Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  blendId                String?
  blend                  Blend?                    @relation(fields: [blendId], references: [id])
  productVariantId       String?
  productVariant         ProductVariant?           @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  code                   String
  productName            String                    @default("Produto não definido")
  sku                    String                    @default("SKU-PENDENTE")
  unit                   String                    @default("kg")
  responsible            String                    @default("Não atribuído")
  priority               ProductionPriority        @default(NORMAL)
  status                 ProductionStatus          @default(PLANNED)
  plannedWeightKg        Decimal                   @db.Decimal(14, 3)
  actualInputKg          Decimal?                  @db.Decimal(14, 3)
  actualOutputKg         Decimal?                  @db.Decimal(14, 3)
  plannedAt              DateTime
  startedAt              DateTime?
  completedAt            DateTime?
  industrialEvents       IndustrialEvent[]
  costEvents             CostEvent[]
  productLots            FinishedProduct[]
  batches                ProductionBatch[]
  consumptions           ProductionConsumption[]
  packagingConsumptions  PackagingConsumption[]
  finishedGoodsMovements FinishedGoodsMovement[]
  resourceUsages         ProductionResourceUsage[]
  costSnapshots          CostCalculationSnapshot[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@unique([companyId, code])
  @@index([blendId, status])
  @@index([productVariantId, status])
}

model ProductionBatch {
  id                String                  @id @default(cuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder         @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  code              String
  machine           String
  operator          String
  greenInputKg      Decimal                 @db.Decimal(14, 3)
  roastedOutputKg   Decimal                 @db.Decimal(14, 3)
  lossKg            Decimal                 @db.Decimal(14, 3)
  lossPercent       Decimal                 @db.Decimal(7, 3)
  startedAt         DateTime
  completedAt       DateTime
  curveData         Json?
  notes             String?
  consumptions      ProductionConsumption[]
  createdAt         DateTime                @default(now())

  @@unique([productionOrderId, code])
  @@index([companyId, completedAt])
}

model ProductionConsumption {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionBatchId String?
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id])
  coffeeLotId       String
  coffeeLot         CoffeeLot        @relation(fields: [coffeeLotId], references: [id])
  reservedKg        Decimal          @db.Decimal(14, 3)
  consumedKg        Decimal          @default(0) @db.Decimal(14, 3)
  percentage        Decimal          @db.Decimal(7, 3)
  realCostPerKg     Decimal          @db.Decimal(14, 4)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([productionOrderId, coffeeLotId])
  @@index([coffeeLotId])
}

model PackagingConsumption {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  materialType      String
  materialName      String
  sku               String?
  quantity          Decimal         @db.Decimal(14, 3)
  unit              String
  unitCost          Decimal         @db.Decimal(14, 4)
  totalCost         Decimal         @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())

  @@index([productionOrderId])
}

model FinishedGoodsMovement {
  id                String                    @id @default(cuid())
  companyId         String
  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrderId String?
  productionOrder   ProductionOrder?          @relation(fields: [productionOrderId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?               @relation(fields: [salesOrderId], references: [id])
  salesOrderItemId  String?
  salesOrderItem    SalesOrderItem?           @relation(fields: [salesOrderItemId], references: [id])
  reservationId     String?
  reservation       InventoryReservation?     @relation(fields: [reservationId], references: [id])
  productVariantId  String?
  productVariant    ProductVariant?           @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  finishedProductId String
  finishedProduct   FinishedProduct           @relation(fields: [finishedProductId], references: [id])
  warehouseId       String
  warehouse         Warehouse                 @relation(fields: [warehouseId], references: [id])
  type              FinishedGoodsMovementType
  packageQuantity   Int
  unit              String                    @default("UN")
  totalWeightKg     Decimal                   @db.Decimal(14, 3)
  sourceType        String?
  sourceId          String?
  idempotencyKey    String?                   @unique
  reason            String
  occurredAt        DateTime                  @default(now())
  createdAt         DateTime                  @default(now())

  @@index([productionOrderId, occurredAt])
  @@index([salesOrderId, occurredAt])
  @@index([productVariantId, occurredAt])
  @@index([finishedProductId, warehouseId])
}

model FinishedProduct {
  id                     String                  @id @default(cuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  blendId                String?
  blend                  Blend?                  @relation(fields: [blendId], references: [id])
  productionOrderId      String?
  productionOrder        ProductionOrder?        @relation(fields: [productionOrderId], references: [id])
  productVariantId       String?
  productVariant         ProductVariant?         @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  warehouseId            String
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id])
  sku                    String
  name                   String
  line                   ProductLineCode         @default(CLASSICOS)
  packageWeightG         Int
  quantityOnHand         Int                     @default(0)
  reservedQuantity       Int                     @default(0)
  standardPrice          Decimal                 @db.Decimal(14, 2)
  salesOrders            SalesOrder[]
  costEvents             CostEvent[]
  finishedGoodsMovements FinishedGoodsMovement[]
  inventoryReservations  InventoryReservation[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([companyId, sku])
  @@unique([productVariantId, warehouseId])
  @@index([productVariantId])
}

model ProductLine {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        ProductLineCode
  name        String
  slug        String
  description String
  positioning String
  sortOrder   Int
  active      Boolean         @default(true)
  products    Product[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([companyId, slug])
  @@unique([companyId, code])
}

model Product {
  id            String           @id @default(cuid())
  productLineId String
  productLine   ProductLine      @relation(fields: [productLineId], references: [id], onDelete: Restrict)
  code          String
  name          String
  slug          String
  description   String
  active        Boolean          @default(true)
  variants      ProductVariant[]
